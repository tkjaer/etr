{
  "uid": "etr-fleet",
  "title": "ETR \u00b7 Fleet",
  "description": "Every site at a glance: site \u00d7 site loss and RTT, worst targets and shared hops. Uses only the low-cardinality etr_target_* and etr_hop_transit_* metrics, so it also works on a central TSDB.",
  "tags": [
    "etr",
    "network",
    "traceroute",
    "ecmp"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/etr-overview",
      "icon": "arrow-left",
