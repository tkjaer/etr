#!/usr/bin/env python3
"""
Generate a merged path DAG from ETR JSON output.

Reads either:
  - Probe run lines (one JSON per line with "hops" array)
  - Discovery summary (last line from -j/-J with "paths" array)

The DAG merges shared hops and fans out at ECMP divergence points,
then converges again when paths rejoin.

Requirements:
    pip install graphviz
    brew install graphviz   # macOS
    apt install graphviz    # Linux

Usage:
    ./path-diagram etr.json
    ./path-diagram etr.json --output paths.svg
    ./path-diagram etr.json --dark
    etr -D -J example.com 2>/dev/null | ./path-diagram -
"""

import json
import sys
import argparse
from collections import OrderedDict

try:
    from graphviz import Digraph
except ImportError:
    print("Error: pip install graphviz", file=sys.stderr)
    sys.exit(1)


def parse_input(filename):
    """Parse ETR JSON, returning a list of paths as [(hash, port, [hop_dicts])].

    Each hop_dict has keys: ip, ptr (optional), asn (optional).
    """
    if filename == '-':
        data = sys.stdin.read()
    else:
        with open(filename, 'r') as f:
            data = f.read()

    lines = [l.strip() for l in data.strip().split('\n') if l.strip()]
    if not lines:
        return []

    paths = []

    # Try discovery summary format first (has "paths" key)
    for line in reversed(lines):
        try:
            obj = json.loads(line)
            if 'paths' in obj and isinstance(obj['paths'], list):
                for p in obj['paths']:
                    raw_hops = p.get('hops', [])
                    hops = []
                    for h in raw_hops:
                        if isinstance(h, dict):
                            ip = h.get('ip', '*') or '*'
                            hops.append({'ip': ip, 'ptr': h.get('ptr', ''), 'asn': h.get('asn', '')})
                        else:
                            hops.append({'ip': h if h else '*', 'ptr': '', 'asn': ''})
                    paths.append((p.get('path_hash', ''), p.get('source_port', 0), hops))
                return paths
        except json.JSONDecodeError:
            continue

    # Fall back to probe run format (one per line)
    seen_hashes = {}
    for line in lines:
        try:
            obj = json.loads(line)
            if 'hops' not in obj:
                continue
            h = obj.get('path_hash', '')
            if h in seen_hashes:
                continue
            seen_hashes[h] = True
            hops = []
            for hop in obj['hops']:
                ip = hop.get('ip', '')
                if hop.get('timeout') or not ip:
                    hops.append({'ip': '*', 'ptr': '', 'asn': ''})
                else:
                    hops.append({'ip': ip, 'ptr': hop.get('ptr', ''), 'asn': hop.get('asn', '')})
            paths.append((h, obj.get('source_port', 0), hops))
        except json.JSONDecodeError:
            continue

    return paths


def build_dag(paths, show_ptr=False, show_asn=False):
    """Build a DAG as adjacency list from paths.

    Returns (nodes, edges, root, leaves) where:
      nodes: {node_id: label}
      edges: {(src, dst): set of path_hashes}
      root:  the root node id
      leaves: set of leaf node ids
    """
    if not paths:
        return {}, {}, None, set()

    # Assign node IDs by (ttl, ip) — this is what makes paths merge
    nodes = OrderedDict()
    edges = {}
    root = 'root'
    nodes[root] = 'src'
    leaves = set()

    # Collect best metadata per (ttl, ip) across all paths
    hop_meta = {}  # (ttl, ip) -> {ptr, asn}

    for path_hash, port, hops in paths:
        prev = root
        for ttl_idx, hop in enumerate(hops):
            ttl = ttl_idx + 1
            ip = hop['ip']
            node_id = f't{ttl}_{ip}'

            # Build label
            if node_id not in nodes:
                if ip == '*':
                    nodes[node_id] = f'* (ttl {ttl})'
                else:
                    nodes[node_id] = ip
            # Track best metadata (first non-empty wins)
            key = (ttl, ip)
            if key not in hop_meta:
                hop_meta[key] = {'ptr': '', 'asn': ''}
            if hop.get('ptr') and not hop_meta[key]['ptr']:
                hop_meta[key]['ptr'] = hop['ptr']
            if hop.get('asn') and not hop_meta[key]['asn']:
                hop_meta[key]['asn'] = hop['asn']

            edge = (prev, node_id)
            if edge not in edges:
                edges[edge] = set()
            edges[edge].add(path_hash)

            prev = node_id

        leaves.add(prev)

    # Enrich labels with PTR/ASN
    for (ttl, ip), meta in hop_meta.items():
        node_id = f't{ttl}_{ip}'
        if node_id in nodes and ip != '*':
            parts = [ip]
            if show_ptr and meta['ptr']:
                parts.append(f"({meta['ptr'][:40]})")
            if show_asn and meta['asn']:
                parts.append(f"[{meta['asn']}]")
            nodes[node_id] = '\\n'.join(parts)

    return nodes, edges, root, leaves


def create_image(paths, output_file='etr-paths', dark_mode=False, show_ptr=False, show_asn=False, show_labels=False):
    """Render the DAG as a Graphviz image."""
    if not paths:
        print("No path data found", file=sys.stderr)
        return

    nodes, edges, root, leaves = build_dag(paths, show_ptr=show_ptr, show_asn=show_asn)
    total = len(paths)

    # Determine output format
    fmt = 'png'
    if '.' in output_file:
        base, ext = output_file.rsplit('.', 1)
        if ext.lower() in ('png', 'svg', 'pdf'):
            fmt = ext.lower()
            output_file = base

    if dark_mode:
        bg, fg, shared_color, split_color, edge_color = (
            '#1e1e1e', '#d4d4d4', '#2d5016', '#7a3b00', '#808080')
    else:
        bg, fg, shared_color, split_color, edge_color = (
            'white', 'black', '#d4edda', '#f8d7da', '#333333')

    dot = Digraph(format=fmt)
    dot.attr(bgcolor=bg, rankdir='TB', nodesep='0.4', ranksep='0.6')
    dot.attr('node', shape='box', style='rounded,filled',
             fontname='monospace', fontsize='10', fontcolor=fg)
    dot.attr('edge', fontname='monospace', fontsize='8',
             color=edge_color, fontcolor=fg)

    # Count how many edges touch each node
    node_edge_count = {}
    for (src, dst), hashes in edges.items():
        node_edge_count[dst] = node_edge_count.get(dst, 0) + 1

    for node_id, label in nodes.items():
        if node_id == root:
            dot.node(node_id, label, shape='ellipse', fillcolor=shared_color)
        elif node_edge_count.get(node_id, 1) > 1 or '*' in label:
            dot.node(node_id, label, fillcolor=split_color)
        else:
            dot.node(node_id, label, fillcolor=shared_color)

    for (src, dst), hashes in edges.items():
        if len(hashes) == total:
            dot.edge(src, dst, penwidth='2')
        else:
            kwargs = {'style': 'dashed', 'penwidth': '1'}
            if show_labels:
                n = len(hashes)
                if n > 10:
                    kwargs['label'] = f'{n}/{total} paths'
                else:
                    kwargs['label'] = ','.join(h[:5] for h in sorted(hashes))
            dot.edge(src, dst, **kwargs)

    try:
        out = dot.render(output_file, cleanup=True)
        print(f"Saved to {out}", file=sys.stderr)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        print("Install graphviz: brew install graphviz / apt install graphviz",
              file=sys.stderr)
        sys.exit(1)


def create_mermaid(paths, output_file=None, show_ptr=False, show_asn=False, show_labels=False):
    """Render the DAG as Mermaid markdown."""
    if not paths:
        print("No path data found", file=sys.stderr)
        return

    nodes, edges, root, leaves = build_dag(paths, show_ptr=show_ptr, show_asn=show_asn)
    total = len(paths)

    lines = ['graph TD']

    # Sanitize labels for mermaid (replace newlines, escape quotes)
    def safe(label):
        return label.replace('\\n', '<br/>').replace('"', "'")

    # Emit nodes
    for node_id, label in nodes.items():
        if node_id == root:
            lines.append(f'    {node_id}(("{safe(label)}"))')
        elif '*' in label:
            lines.append(f'    {node_id}[/"{safe(label)}"\\]')
        else:
            lines.append(f'    {node_id}["{safe(label)}"]')

    # Emit edges
    for (src, dst), hashes in edges.items():
        if len(hashes) == total:
            lines.append(f'    {src} ==> {dst}')
        else:
            if show_labels:
                n = len(hashes)
                if n > 10:
                    label = f'{n}/{total} paths'
                else:
                    label = ','.join(h[:5] for h in sorted(hashes))
                lines.append(f'    {src} -."{safe(label)}".- {dst}')
            else:
                lines.append(f'    {src} -.-> {dst}')

    output = '\n'.join(lines)

    # Wrap in markdown fenced code block if output is .md
    wrap_md = output_file and output_file.endswith('.md')
    if wrap_md:
        output = f'```mermaid\n{output}\n```'

    if output_file:
        with open(output_file, 'w') as f:
            f.write(output + '\n')
        print(f"Saved to {output_file}", file=sys.stderr)
    else:
        print(output)


def main():
    parser = argparse.ArgumentParser(
        description='Generate merged path DAG from ETR JSON output',
        epilog='Reads probe-run JSON or discovery summary (last line from -j/-J).')
    parser.add_argument('input', help='ETR JSON file (- for stdin)')
    parser.add_argument('-o', '--output', help='Output file (default: etr-paths.png)')
    parser.add_argument('--dark', action='store_true', help='Dark mode color scheme')
    parser.add_argument('--ptr', action='store_true', help='Show PTR (hostname) in node labels')
    parser.add_argument('--asn', action='store_true', help='Show ASN in node labels')
    parser.add_argument('--labels', action='store_true', help='Show path hash labels on edges')
    parser.add_argument('--mermaid', action='store_true', help='Output Mermaid markdown instead of image')

    args = parser.parse_args()
    paths = parse_input(args.input)
    if args.mermaid:
        create_mermaid(paths, args.output, show_ptr=args.ptr, show_asn=args.asn,
                       show_labels=args.labels)
    else:
        create_image(paths, args.output or 'etr-paths', dark_mode=args.dark,
                     show_ptr=args.ptr, show_asn=args.asn, show_labels=args.labels)


if __name__ == '__main__':
    main()
